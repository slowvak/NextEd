FROM python:3.11-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

# Install deps (cached layer — only invalidated when lockfile changes)
COPY server/pyproject.toml server/uv.lock server/
RUN cd server && uv sync --no-dev --frozen

# Copy application code
COPY server/ server/

# config.json is gitignored — it holds the machine-specific source_directory
# the UI writes at runtime — so it does not exist in a fresh clone. Bake the
# tracked default; compose bind-mounts the real one over it.
COPY config.default.json config.json

RUN mkdir -p models

COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

EXPOSE 8060

ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["server/.venv/bin/python", "server/main.py"]
